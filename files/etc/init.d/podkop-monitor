#!/bin/sh /etc/rc.common
# podkop-monitor: вспомогательный sing-box для замеров серверов подписки (трафик не проксирует)
# и задания cron.

START=99
STOP=10
USE_PROCD=1

CRON=/etc/crontabs/root
MARK="# podkop-monitor"

cron_remove() {
    [ -f $CRON ] && sed -i "/$MARK\$/d" $CRON
}

cron_install() {
    local interval minute
    config_get interval main interval 15
    # у каждого роутера своя минута для суточных задач — чтобы не ходить в GitHub и к провайдеру одновременно
    minute=$(( $(hexdump -n 2 -e '"%u"' /dev/urandom) % 60 ))
    cron_remove
    echo "*/$interval * * * * /usr/bin/podkop-monitor check $MARK" >> $CRON
    echo "$minute 4 * * * /usr/bin/podkop-monitor daily $MARK" >> $CRON
    /etc/init.d/cron reload 2>/dev/null || /etc/init.d/cron restart
}

start_service() {
    local enabled
    config_load podkop-monitor
    config_get enabled main enabled 1
    if [ "$enabled" != 1 ]; then
        cron_remove; /etc/init.d/cron reload 2>/dev/null
        return 0
    fi
    cron_install

    # ссылку на подписку поменяли в настройках — пересобрать список серверов в фоне
    local url
    config_get url main subscription_url ""
    if [ "$url" != "$(cat /etc/podkop-monitor/sub.url 2>/dev/null)" ]; then
        if [ -n "$url" ]; then
            ( sleep 2; /usr/bin/podkop-monitor sub-update ) </dev/null >/dev/null 2>&1 &
        else
            rm -f /etc/podkop-monitor/sb.json /etc/podkop-monitor/servers.tsv /etc/podkop-monitor/sub.url \
                  /etc/podkop-monitor/country.csv /tmp/podkop-monitor/country.csv
        fi
    fi

    [ -s /etc/podkop-monitor/sb.json ] || return 0
    mkdir -p /tmp/podkop-monitor/sb
    procd_open_instance helper
    procd_set_param command /usr/bin/sing-box run -c /etc/podkop-monitor/sb.json -D /tmp/podkop-monitor/sb
    procd_set_param respawn 3600 10 5
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # cron оставляем: stop бывает при restart; убирается при disable/удалении пакета
    :
}

service_triggers() {
    procd_add_reload_trigger podkop-monitor
}

reload_service() {
    stop
    start
}
