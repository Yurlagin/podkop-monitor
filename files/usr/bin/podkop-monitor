#!/bin/sh
# podkop-monitor — мониторинг доступности серверов podkop и подписки.

L=/usr/libexec/podkop-monitor

case "$1" in
    check)        exec $L/check.sh ;;
    sub-update|sub-update-force)
        # обновить список серверов подписки и сразу проверить для них страну YouTube;
        # --force / sub-update-force — принять новый список, даже если серверов стало заметно меньше
        { [ "$1" = sub-update-force ] || [ "$2" = --force ]; } && export PM_SUB_FORCE=1
        $L/sub-update.sh; rc=$?
        sleep 5
        $L/country.sh
        exit $rc
        ;;
    country)      exec $L/country.sh ;;
    update-check) exec $L/update.sh check ;;
    notify-test)  exec $L/notify.sh test "$2" "$3" "$4" ;;
    notify-chatid) exec $L/notify.sh chatid "$2" "$3" ;;
    apply|remove|add|rename|sync)
        # правка секции podkop: <секция> <имя сервера>...
        exec $L/edit.sh "$@" ;;
    upgrade)      exec $L/update.sh upgrade ;;
    daily)
        # раз в сутки: подписка → страна YouTube → проверка обновлений пакета
        . $L/common.sh
        $0 sub-update
        if [ "$PM_UPDATE_CHECK" = 1 ] && $L/update.sh check \
           && [ "$(jq -r '.available' $PM_RUN/update.json 2>/dev/null)" = true ] && [ "$PM_AUTO_UPGRADE" = 1 ]; then
            # автоматическое обновление мониторинга (настройка «Обновлять автоматически», по умолчанию включена)
            logger -t podkop-monitor "ставлю новую версию $(jq -r '.latest' $PM_RUN/update.json) автоматически"
            $L/update.sh upgrade > $PM_RUN/upgrade.log 2>&1; echo $? > $PM_RUN/upgrade.rc
        fi
        exit 0
        ;;
    version)      cat $L/VERSION ;;
    bg)
        # для LuCI: запустить длинную команду в фоне; результат — /tmp/podkop-monitor/<cmd>.log и .rc
        case "$2" in check|sub-update|sub-update-force|upgrade|apply|remove|add|rename|sync) ;; *) echo "bg: check|sub-update|sub-update-force|upgrade|apply|remove|add|rename|sync"; exit 1 ;; esac
        R=/tmp/podkop-monitor; mkdir -p $R; rm -f $R/$2.rc
        C=$2; shift 2
        ( $0 "$C" "$@" > $R/$C.log 2>&1; echo $? > $R/$C.rc ) </dev/null >/dev/null 2>&1 &
        exit 0
        ;;
    *)
        cat <<EOF
Использование: podkop-monitor <команда>
  check         прогон замеров (cron, раз в interval минут)
  sub-update [--force]  обновить список серверов подписки (+ страна YouTube);
                --force — принять, даже если серверов стало заметно меньше
  country       проверить страну YouTube через серверы подписки
  daily         sub-update + country + update-check (cron, раз в сутки)
  update-check  проверить наличие новой версии
  upgrade       установить новую версию
  apply  <секция> <имя>...  заменить ссылки серверов в секции podkop ссылками из подписки
  remove <секция> <имя>...  убрать серверы из секции podkop
  add    <секция> <имя>...  добавить серверы подписки в секцию podkop
  rename <секция> <старое> <новое>...  сменить имя ссылки (сервер переименован провайдером), история переносится
  sync   <секция> <имена для apply>... -- <старое> <новое>...  apply и rename за один перезапуск podkop
  notify-test <токен> <chat_id> [0|1]  тестовое сообщение в Telegram (1 — через прокси podkop)
  notify-chatid <токен> [0|1]          ID чата из последнего сообщения боту
  version       показать версию
  bg <cmd> ...  запустить команду в фоне (для LuCI): результат в /tmp/podkop-monitor/<cmd>.log/.rc
EOF
        exit 1
        ;;
esac
